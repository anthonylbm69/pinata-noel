# Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...            # clé "anon" / "publishable" (publique)
SUPABASE_SERVICE_ROLE_KEY=eyJ...                # clé "service_role" / "secret" — SERVEUR UNIQUEMENT, jamais dans le navigateur
# Pour « npm run db:push » uniquement (en local, pas besoin sur Vercel) :
# Supabase > bouton Connect > Session pooler > URI, avec ton mot de passe de base
DATABASE_URL=postgresql://postgres.xxxxxxxx:MOT_DE_PASSE@aws-0-eu-west-3.pooler.supabase.com:5432/postgres
